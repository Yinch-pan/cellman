[Unit]
Description=Check cellman health, memory, disk, backup and certificate
After=cellman.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/cellman/mail.env
EnvironmentFile=-/etc/cellman/operations.env
ExecStart=/usr/bin/python3 /srv/cellman/current/deploy/cellman-health.py
StateDirectory=cellman-health
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=192M
TimeoutStartSec=90

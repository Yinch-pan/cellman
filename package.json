{
  "name": "cellman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node --import tsx apps/server/src/index.ts",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:unit": "vitest run scripts packages apps/web/test",
    "i18n:extract": "node --import tsx scripts/extract-ui-i18n.mjs",
    "i18n:check": "node --import tsx scripts/extract-ui-i18n.mjs --check",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run apps/server/test",
    "test:e2e": "playwright test",
    "test:playthrough": "playwright test tests/e2e/four-player.spec.ts",
    "test:operations": "tsx scripts/check-local-operations.ts",
    "typecheck": "tsc --noEmit",
    "check:rules": "tsx scripts/check-rules.ts",
    "dev": "tsx apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
